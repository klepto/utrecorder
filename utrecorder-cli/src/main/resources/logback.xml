<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%gray(%d{HH:mm:ss.SSS}) %highlight(%-5level) %cyan(%logger{0}) - %msg%n%ex</pattern>
        </encoder>
    </appender>

    <root level="${utrecorder.log_level:-${UTRECORDER_LOG_LEVEL:-info}}">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
